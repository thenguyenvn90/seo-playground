{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Write(.env*)",
      "Write(**/*.secret)",
      "Write(**/*.pem)",
      "Write(src/generated/**)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)"
    ],
    "ask": [
      "Bash(git push **)",
      "Bash(git commit **)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(prisma migrate reset*)",
      "Bash(npx prisma migrate reset*)"
    ]
  }
}
